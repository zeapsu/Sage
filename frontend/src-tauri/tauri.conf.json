{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sage",
  "version": "0.1.0",
  "identifier": "com.sage.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sage",
        "width": 640,
        "height": 120,
        "minWidth": 640,
        "minHeight": 48,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "identifier": "com.sage.desktop",
    "externalBin": ["binaries/main"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
